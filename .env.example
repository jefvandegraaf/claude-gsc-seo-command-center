# Command-line keys. Set these as environment variables (user-level), never in a committed file.
# The desktop app doesn't use this: it stores keys encrypted with your OS keychain (Settings and keys).

GOOGLE_APPLICATION_CREDENTIALS=C:\path\outside\this\repo\seo-reader.json
RESEND_API_KEY=
FATHOM_API_TOKEN=
PSI_API_KEY=
ANTHROPIC_API_KEY=
# SEO_CC_DATA=   optional: a different data folder
